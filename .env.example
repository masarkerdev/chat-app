# Supabase ড্যাশবোর্ড → Project Settings → API থেকে কপি করুন
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon public" key অথবা নতুন "publishable" key (sb_publishable_...) — দুটোই চলবে
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Web Push (অ্যাপ বন্ধ থাকলেও নোটিফিকেশন) ----
# `npm run vapid` চালালে দুটি key পাবেন। একবার তৈরি করে আর বদলাবেন না
# (বদলালে সবাইকে আবার নোটিফিকেশন চালু করতে হবে)।
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# এটি গোপন — কখনো NEXT_PUBLIC_ দিয়ে শুরু করবেন না, GitHub-এ দেবেন না
VAPID_PRIVATE_KEY=
# আপনার যোগাযোগের ইমেইল (push সার্ভিস সমস্যা হলে জানানোর জন্য)
VAPID_SUBJECT=mailto:you@example.com
# false দিলে লক স্ক্রিনে মেসেজের লেখা না দেখিয়ে শুধু "নতুন মেসেজ" দেখাবে
NOTIFY_PREVIEW=true

# ---- ঐচ্ছিক ----
# যেকোনো লম্বা গোপন লেখা দিলে /api/keepalive শুধু Vercel-ই ডাকতে পারবে
CRON_SECRET=
